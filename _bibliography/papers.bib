@misc{sun2026distopd,
  abbr          = {Preprint},
  title         = {Rethinking Offline On-Policy Distillation: From Scalar Advantages to Distributional Supervision},
  author        = {Sun, Qi and Zhang, Siyue and Song, Tingyu and Zhao, Yilun and Zhao, Chen},
  howpublished  = {Under review},
  year          = {2026},
  abstract      = {On-policy distillation (OPD) transfers teacher capabilities through token-level feedback on student-generated trajectories, but repeatedly evaluating fresh rollouts with the teacher is computationally expensive. Offline methods such as Lightning OPD reduce this cost by caching recorded tokens' teacher log-probabilities on fixed reference rollouts. By extending the idea to a multi-turn agentic search setup, we find that it consistently underperforms the SFT starting point trained by the same teacher. We empirically observe greater teacher-reference mismatch than in mathematical reasoning and post-training distributional flattening, and theoretically show that scalar advantage supervision on fixed rollouts admits solutions with flattened output distributions under suitable conditions. Motivated by these findings, we propose Distributional On-Policy Distillation (DistOPD), a simple yet effective offline OPD method that retains candidate-token probabilities from both reference and teacher at selected positions and aggregates the remaining parts into a residual token. On agentic search, DistOPD achieves performance comparable to online OPD while improving student-teacher alignment and using training GPU-hours comparable to Lightning OPD.},
  code          = {https://github.com/AlbertQiSun/DistOPD},
  bibtex_show   = {true},
  selected      = {true}
}

@inproceedings{sun2026weaksignals,
  abbr          = {NeurIPS},
  title         = {From "Weak" Signals to Strong Models: Preference Delta Aggregation with LoRA Merging},
  author        = {Sun, Qi and Zhang, Siyue and Chen, Yulin and Xue, Yuxiang and Peng, Ru and Zhao, Chen},
  booktitle     = {Advances in Neural Information Processing Systems (NeurIPS)},
  year          = {2026},
  eprint        = {2606.00357},
  archiveprefix = {arXiv},
  abstract      = {Training strong large language models (LLMs) requires high-quality supervision, which is often scarce. Recent work shows that paired preference data from weak-weaker model pairs (e.g., Qwen3 4B over 1.7B), despite the limited quality of individual responses, can provide an effective supervision signal through relative quality deltas, which we term a "weak" signal. This motivates a key research question: can multiple "weak" signals be constructively aggregated for improving strong models (e.g., Qwen3 8B)? To this end, we propose Preference Delta Aggregation (PDA), the first framework that derives a preference delta from each weak-weaker model pair, instantiates it as a LoRA adapter learned through preference optimization, and aggregates the resulting deltas via LoRA merging. To further mitigate directional interference during LoRA merging, we introduce Geometric Alignment Merging (GAM), a geometry-aware merging method that aligns adapter subspaces before aggregation, enabling more robust composition of diverse deltas. Evaluations on knowledge reasoning and agentic search benchmarks show that aggregating multiple "weak" signals pushes performance beyond any single signal, with further gains as additional signals are incorporated. Correspondingly, PDA with GAM improves the strong model by 6.8 and 7.3 points on average for knowledge reasoning and agentic search, respectively. It outperforms all single-delta and multi-delta baselines, exceeding the best single-delta baseline by 2.1 and 4.3 points. Further analysis attributes these gains to the effective composition of complementary capabilities encoded across distinct preference deltas.},
  arxiv         = {2606.00357},
  bibtex_show   = {true},
  selected      = {true}
}

@misc{liu2026searchdonotguess,
  abbr          = {Preprint},
  title         = {Search, Do not Guess: Teaching Small Language Models to Be Effective Search Agents},
  author        = {Liu*, Yizhou and Sun*, Qi and Chen, Yulin and Zhang, Siyue and Zhao, Chen},
  howpublished  = {Under review},
  year          = {2026},
  eprint        = {2604.04651},
  archiveprefix = {arXiv},
  abstract      = {Agents equipped with search tools have emerged as effective solutions for knowledge-intensive tasks. While Large Language Models (LLMs) exhibit strong reasoning capabilities, their high computational cost limits practical deployment for search agents. Consequently, recent work has focused on distilling agentic behaviors from LLMs into Small Language Models (SLMs). Through comprehensive evaluation on complex multi-hop reasoning tasks, we find that despite possessing less parametric knowledge, SLMs invoke search tools less frequently and are more prone to hallucinations. To address this issue, we propose a lightweight fine-tuning approach that explicitly trains SLMs to reliably retrieve and generate answers grounded in retrieved evidence. Compared to agent distillation from LLMs, our approach improves performance by 17.3 scores on Bamboogle and 15.3 scores on HotpotQA, achieving LLM-level results across benchmarks. Our further analysis reveals that adaptive search strategies in SLMs often degrade performance, highlighting the necessity of consistent search behavior for reliable reasoning.},
  arxiv         = {2604.04651},
  annotation    = {* Equal contribution},
  bibtex_show   = {true},
  selected      = {true}
}
